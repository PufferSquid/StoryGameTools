@page "/parser"
@using StoryGameTools.Components.Services
@inject ScriptParserService ParserService
@inject CharacterDatabaseService CharacterDb
@inject ProjectService ProjectService
@inject IJSRuntime JS
@implements IDisposable


<div class="parser-page">
    <h2>Script Parser</h2>

    <div class="toolbar">
        <InputFile OnChange="OnFilesSelected" multiple accept=".txt"
                   id="fileInput" style="display:none" />
        <button class="btn" onclick="document.getElementById('fileInput').click()">
            + Add Files
        </button>
        <button class="btn btn-primary" @onclick="ConvertAll" 
                disabled="@(!_files.Any())">
            Convert All
        </button>
        <button class="btn btn-success" @onclick="SaveAll"
                disabled="@(!_files.Any(f => f.HasOutput))">
            Save All
        </button>
        @if (_saveConfirmation != null)
        {
            <span class="save-confirmation">@_saveConfirmation</span>
        }
    </div>

    @if (_allWarnings.Any())
    {
        <div class="warnings-panel">
            @foreach (var (fileName, warning) in _allWarnings)
            {
                <div class="warning-item">
                    <strong>@fileName:</strong> @warning
                </div>
            }
        </div>
    }

    <div class="drop-zone @(_isDragging ? "dragging" : "")"
        @ref="_dropZone"
        @ondragover:preventDefault
        @ondragover="() => _isDragging = true"
        @ondragleave="() => _isDragging = false">
        <p class="drop-hint">Drop .txt files here or use Add Files above</p>
    </div>

    <div class="columns">
        <div class="column">
            <h3>Input</h3>
            @foreach (var file in _files)
            {
                <div class="script-block">
                    <div class="script-block-header">
                        <span>@file.FileName</span>
                        <button class="btn-remove" 
                                @onclick="() => RemoveFile(file)">✕</button>
                    </div>
                    <pre class="script-text">@file.InputText</pre>
                </div>
            }
        </div>

        @if (_files.Any(f => f.HasOutput))
        {
            <div class="column">
                <h3>Output</h3>
                @foreach (var file in _files)
                {
                    <div class="script-block">
                        <div class="script-block-header">
                            <span>@file.FileName</span>
                        </div>
                        <pre class="script-text">@(file.OutputText ?? "Not yet converted.")</pre>
                    </div>
                }
            </div>
        }
    </div>
</div>



@code {
    private List<ScriptFile> _files = new();
    private List<(string FileName, string Warning)> _allWarnings = new();
    private bool _isDragging = false;
    private string? _saveConfirmation;

    private ElementReference _dropZone;
    private DotNetObjectReference<Parser>? _dotNetRef;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("parserInterop.registerDropZone", _dropZone, _dotNetRef);
    }

    [JSInvokable]
    public async Task OnFileDropped(string name, string text)
    {
        if (_files.Any(f => f.FileName == name)) return;
        _files.Add(new ScriptFile { FileName = name, InputText = text });
        _isDragging = false;
        await InvokeAsync(StateHasChanged);
    }

    // Reads files selected via the file picker
    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
            await LoadFile(file.Name, file.OpenReadStream());
    }

    private async Task LoadFile(string name, Stream stream)
    {
        // Skip duplicates
        if (_files.Any(f => f.FileName == name)) return;

        using var reader = new StreamReader(stream);
        var text = await reader.ReadToEndAsync();
        _files.Add(new ScriptFile { FileName = name, InputText = text });
    }

    private async Task ConvertAll()
    {
        _allWarnings.Clear();
        var db = await CharacterDb.LoadAsync();
        await ParserService.ParseAllAsync(_files, db);

        // Flatten all warnings across files for the warnings panel
        foreach (var file in _files)
            foreach (var w in file.Warnings)
                _allWarnings.Add((file.FileName, w));
    }

    private async Task SaveAll()
    {
        var basePath = ProjectService.GetProjectPath("dialogueScripts");
        if (basePath == null) return;

        foreach (var file in _files.Where(f => f.HasOutput))
        {
            var outName = Path.ChangeExtension(file.FileName, ".ink");
            var outPath = Path.Combine(basePath, outName);
            await File.WriteAllTextAsync(outPath, file.OutputText);
        }

        _saveConfirmation = $"Saved {_files.Count(f => f.HasOutput)} file(s) to dialogueScripts/";
    }

    private void RemoveFile(ScriptFile file)
    {
        _files.Remove(file);
        _allWarnings.RemoveAll(w => w.FileName == file.FileName);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}